# Copy this file to server/.env for local development
MONGODB_URI=mongodb://127.0.0.1:27017/astrocareer
JWT_SECRET=local-development-secret-change-me-in-production
PORT=5000
CLIENT_URL=http://localhost:5173

# Optional - fill in when connecting a real AI provider
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Optional - seed the admin account
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme123
